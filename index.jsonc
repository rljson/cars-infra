{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "cars-infra",

  // 1-2 sentence summary about this repo.
  "summary": "Azure resources of the cars application: bootstrap script, deploy script and Bicep components with one parameter file per environment. Deployed by hand, no CI.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "Azure resources: resource group, Log Analytics, container registry, AKS, Key Vault, SQL, storage",
    "Bicep in the CARAT layout, what-if before every deploy",
    "environment demo in rg-cars-demo, West Europe"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {},

    // "<repo-b>": "why / API"
    "usedBy": {
      "cars-deployment": "deploys onto the AKS cluster and pulls from the registry created here"
    }
  }
}
