{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/cars-infra",

  // 1-2 sentence summary about this repo.
  "summary": "Azure resources of the cars application: bootstrap.sh creates the resource group, deploy.sh deploys Bicep components with what-if and a yes, test.sh builds every Bicep file. Deployed by hand, no CI.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "Azure resources: resource group, Log Analytics, container registry; later network, Container Apps environments, SQL, storage",
    "Bicep in a component layout, what-if before every deploy; components: log-analytics, container-registry",
    "stages dev, stage and prod to come, Germany West Central; demo deleted"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {},

    // "<repo-b>": "why / API"
    "usedBy": {
      "cars-deployment": "deploys the container apps onto the resources created here and pulls from its registry"
    }
  }
}
