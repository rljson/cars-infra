{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/cars-infra",

  // 1-2 sentence summary about this repo.
  "summary": "Azure resources of the cars application in the stages dev, stage and prod: Node.js scripts bootstrap.js (providers, resource group), deploy.js (Bicep components with what-if and a yes) and test.js (unit tests, Bicep builds). Deployed by hand, no CI yet.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "Azure resources per stage: resource group, Log Analytics, container registry, VNet with a subnet and NSG per side, Container Apps environments origin and custom; later SQL, storage, identities",
    "Bicep in a component layout, <component>-<stage>.bicepparam, what-if before every deploy",
    "stages dev, stage, prod in rg-cars-<stage>, Germany West Central"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {},

    // "<repo-b>": "why / API"
    "usedBy": {
      "cars-deployment": "deploys the container apps into the Container Apps environments created here and pulls from the registry of the stage"
    }
  }
}
