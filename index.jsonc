{
  // The package name, as declared in pubspec.yaml / package.json.
  "name": "@rljson/cars-infra",

  // 1-2 sentence summary about this repo.
  "summary": "Azure resources of the cars application, shared by the stages dev, stage and prod in one resource group rg-cars: Node.js scripts bootstrap.js (providers, resource group), deploy.js (Bicep components with what-if and a yes) and test.js (unit tests, Bicep builds). Deployed by hand, no CI yet.",

  // 1-3 bullet points: the problem space.
  "domain": [
    "Azure resources: resource group rg-cars, Log Analytics, container registry crcars, VNet with a subnet and NSG per node pool, public DNS zone, AKS cluster aks-cars with node pools system, origin, custom; later SQL, storage, identities",
    "AKS: Entra RBAC, workload identity, Azure CNI overlay with Cilium, taints per side, AcrPull, application routing add-on with Gateway API",
    "Bicep in a component layout, one <component>.bicepparam each, what-if before every deploy, Germany West Central"
  ],

  // The repos this one depends on and the repos depending on it.
  // Keep the reason or the API behind each entry, not just the name.
  "interfaces": {
    // "<repo-a>": "why / API"
    "uses": {},

    // "<repo-b>": "why / API"
    "usedBy": {
      "cars-deployment": "deploys the apps into the cluster aks-cars created here, onto the node pools origin and custom, and pulls the images from crcars"
    }
  }
}
